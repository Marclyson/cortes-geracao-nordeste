	measure 'Não realizada · var %' =
			VAR _A = [Não realizada · período]
			VAR _B = [Não realizada · ano anterior]
			RETURN
			    IF ( NOT ISBLANK ( _B ) && _B <> 0, DIVIDE ( _A - _B, _B ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Período
		lineageTag: cb747720-eb1a-5237-b3c1-fc317407f347

	measure 'Geração · var %' =
			VAR _A = [Geração · período]
			VAR _B = [Geração · ano anterior]
			RETURN
			    IF ( NOT ISBLANK ( _B ) && _B <> 0, DIVIDE ( _A - _B, _B ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Período
		lineageTag: c8b2da6d-1764-5946-9f4e-9f3e0858c212

	measure 'Usinas com corte · var %' =
			VAR _A = [Usinas com corte · período]
			VAR _B = [Usinas com corte · ano anterior]
			RETURN
			    IF ( NOT ISBLANK ( _B ) && _B <> 0, DIVIDE ( _A - _B, _B ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Período
