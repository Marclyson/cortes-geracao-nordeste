		lineageTag: 92c56b28-3b06-50e3-b44d-c91892c04dd3
		summarizeBy: none
		sourceColumn: patamar

	column Hora
		dataType: int64
		formatString: 0
		lineageTag: 9acce47a-6d49-5e99-9968-965cf65a0c15
		summarizeBy: none
		sourceColumn: hora

	column usinas
