/// Geração e geração não realizada por usina e dia (marts.fct_restricao_usina_dia)
table 'Restrição diária'
	lineageTag: 69a8757d-1788-4416-aeab-a03c13816a37

	/// Geração verificada, em GWh
	measure 'Geração (GWh)' = DIVIDE(SUM('Restrição diária'[geracao_mwh]), 1000)
		formatString: #,0
		lineageTag: 98e3fde5-8ad1-4c69-921c-9cae748e0b30

	/// Geração não realizada apurada (GNRa) pelo ONS, em GWh
	measure 'Não realizada (GWh)' = DIVIDE(SUM('Restrição diária'[nao_realizada_mwh]), 1000)
		formatString: #,0
		lineageTag: 194894c2-0c70-4347-85a4-b0765951c755

	/// Parte da geração possível (verificada mais não realizada) que deixou de acontecer
	measure '% cortado' = DIVIDE([Não realizada (GWh)], [Geração (GWh)] + [Não realizada (GWh)])
		formatString: 0.0%
		lineageTag: 735a25d1-c101-4323-a957-a4caa03dd583

	/// Usinas ou conjuntos com alguma geração não realizada no período
	measure 'Usinas com corte' = CALCULATE(DISTINCTCOUNT('Restrição diária'[usina_id]), 'Restrição diária'[nao_realizada_mwh] > 0)
		formatString: #,0
		lineageTag: 37eedd0d-dadd-4db7-888a-202072502c2c

	/// Último dia com dados
	measure 'Dados até' = "Dados até " & FORMAT(MAX('Restrição diária'[dia]), "dd/mm/yyyy")
		formatString: General
		lineageTag: 86b4f5b0-72c1-41ad-8ef9-4a15b1c5aa04

	measure 'Energética (ENE)' = DIVIDE(SUM('Restrição diária'[nao_realizada_ene_mwh]), 1000)
		formatString: #,0
		displayFolder: Por razão
		lineageTag: ec6777a3-eef9-4356-ac98-2bc31829ff48

	measure 'Confiabilidade (CNF)' = DIVIDE(SUM('Restrição diária'[nao_realizada_cnf_mwh]), 1000)
		formatString: #,0
		displayFolder: Por razão
		lineageTag: f7bb3b37-0767-4ef6-8b95-d36daff83c1e

	measure 'Indisponibilidade externa (REL)' = DIVIDE(SUM('Restrição diária'[nao_realizada_rel_mwh]), 1000)
		formatString: #,0
		displayFolder: Por razão
		lineageTag: 59a66fa0-cc78-4e8c-9890-c9a92ed129b4

	measure 'Parecer de acesso (PAR)' = DIVIDE(SUM('Restrição diária'[nao_realizada_par_mwh]), 1000)
		formatString: #,0
		displayFolder: Por razão
		lineageTag: 80f67c14-4086-4190-b9f2-c1c1ecd4e8cb

	/// Geração verificada mais geração não realizada
	measure 'Geração possível (GWh)' = [Geração (GWh)] + [Não realizada (GWh)]
		formatString: #,0
		displayFolder: Base
		lineageTag: d4738451-04a7-5afc-8743-0b358a63c17e

	/// Geração não realizada sem razão informada pelo ONS
	measure 'Sem razão (GWh)' = DIVIDE(SUM('Restrição diária'[nao_realizada_sem_razao_mwh]), 1000)
		formatString: #,0
		displayFolder: Por razão
		lineageTag: 955bd5f7-aeac-5316-992f-8286d9e9041c

	/// Restrição de origem local (rede próxima à usina)
	measure 'Origem local (GWh)' = DIVIDE(SUM('Restrição diária'[nao_realizada_loc_mwh]), 1000)
		formatString: #,0
		displayFolder: Por origem
		lineageTag: e4902b9f-ab03-5314-9a84-5b318dcedc89

	/// Restrição de origem sistêmica (sistema interligado)
	measure 'Origem sistêmica (GWh)' = DIVIDE(SUM('Restrição diária'[nao_realizada_sis_mwh]), 1000)
		formatString: #,0
		displayFolder: Por origem
		lineageTag: 74f4909a-0397-515d-beeb-fdc4249866c4

	/// Geração não realizada sem origem informada
	measure 'Sem origem (GWh)' = DIVIDE(SUM('Restrição diária'[nao_realizada_sem_origem_mwh]), 1000)
		formatString: #,0
		displayFolder: Por origem
		lineageTag: 640078ec-6844-5f6d-ac8f-638035d19e8f

	/// Soma das horas com restrição de cada usina em cada dia
	measure 'Horas de restrição' = SUM('Restrição diária'[horas_restricao])
		formatString: #,0
		displayFolder: Base
		lineageTag: e4defcea-960a-52c2-906b-c748e9efba92

	/// Último dia com dados, ignorando o filtro de datas
	measure 'Última data com dados' = CALCULATE(MAX('Restrição diária'[dia]), REMOVEFILTERS('Calendário'))
		formatString: dd/mm/yyyy
		displayFolder: Período
		lineageTag: 49827826-68fb-5e00-b139-c79509b62b5b

	/// Fim do período analisado, limitado ao último dia com dados
	measure '_Fim do período' = MIN(MAX('Calendário'[Data]), [Última data com dados])
		formatString: dd/mm/yyyy
		isHidden
		displayFolder: Período
		lineageTag: 8fd8e624-cf74-5335-916e-fc360ad44a3c

	/// [Não realizada (GWh)] no período analisado: o filtro de datas, ou os últimos 12 meses quando não há filtro
	measure 'Não realizada · período' =
			VAR _Fim = [_Fim do período]
			RETURN
			    IF (
			        ISFILTERED ( 'Calendário' ),
			        CALCULATE ( [Não realizada (GWh)], KEEPFILTERS ( 'Calendário'[Data] <= _Fim ) ),
			        CALCULATE ( [Não realizada (GWh)], DATESINPERIOD ( 'Calendário'[Data], _Fim, -12, MONTH ) )
			    )
		formatString: #,0
		displayFolder: Período
		lineageTag: bef7b0d2-db76-5132-9413-08e2244cad9c

	/// [Não realizada (GWh)] no mesmo período um ano antes, cortado na mesma data
	measure 'Não realizada · ano anterior' =
			VAR _Fim = [_Fim do período]
			RETURN
			    IF (
			        ISFILTERED ( 'Calendário' ),
			        CALCULATE (
			            [Não realizada (GWh)],
			            REMOVEFILTERS ( 'Calendário' ),
			            DATEADD ( CALCULATETABLE ( VALUES ( 'Calendário'[Data] ), KEEPFILTERS ( 'Calendário'[Data] <= _Fim ) ), -1, YEAR )
			        ),
			        CALCULATE (
			            [Não realizada (GWh)],
			            REMOVEFILTERS ( 'Calendário' ),
			            DATESINPERIOD ( 'Calendário'[Data], EDATE ( _Fim, -12 ), -12, MONTH )
			        )
			    )
		formatString: #,0
		displayFolder: Período
		lineageTag: 31240304-e1c0-5f35-b68b-8685a664a5ee

	/// [Geração (GWh)] no período analisado: o filtro de datas, ou os últimos 12 meses quando não há filtro
