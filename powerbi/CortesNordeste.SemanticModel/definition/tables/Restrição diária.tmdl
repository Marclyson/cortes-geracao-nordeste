			        "@v", VAR _m = 'Calendário'[Mês] RETURN CALCULATE ( [% cortado], REMOVEFILTERS ( 'Calendário' ), 'Calendário'[Mês] = _m )
			    )
			VAR _Min = MINX ( _Meses, [@v] )
			VAR _Max = MAXX ( _Meses, [@v] )
			VAR _N = COUNTROWS ( _Meses )
