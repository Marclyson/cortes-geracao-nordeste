	measure '% cortado · período' = DIVIDE([Não realizada · período], [Geração · período] + [Não realizada · período])
		formatString: 0.0%
		displayFolder: Período
		lineageTag: a9b32c2a-3ad4-5c4d-af3a-e4eb1105a1c1

