{
  "name": "Dome Analytics",
  "dataColors": [
    "#252423",
    "#F2C811",
    "#8A8886",
    "#967100",
    "#C8C6C4",
    "#1F4E8C",
    "#605E5C",
    "#FAD227"
  ],
  "foreground": "#191919",
  "foregroundNeutralSecondary": "#605E5C",
  "foregroundNeutralTertiary": "#8A8886",
  "background": "#FFFFFF",
  "backgroundLight": "#F6F5F3",
  "backgroundNeutral": "#E1DFDD",
  "tableAccent": "#F2C811",
  "good": "#107C10",
  "neutral": "#B54708",
  "bad": "#C84720",
  "maximum": "#967100",
  "center": "#F2C811",
  "minimum": "#FDF8DC",
  "textClasses": {
    "callout": {
      "fontSize": 26,
      "fontFace": "Segoe UI Semibold",
      "color": "#191919"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#191919"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#191919"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#605E5C"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F6F5F3"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E1DFDD"
              }
            },
            "radius": 2
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 10,
            "left": 12,
            "right": 12
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "visualTooltip": [
          {
            "background": {
              "solid": {
                "color": "#191919"
              }
            },
            "titleFontColor": {
              "solid": {
                "color": "#F2C811"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "fontSize": 10,
            "transparency": 0
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 0,
            "bottom": 4,
            "left": 0,
            "right": 0
          }
        ]
      }
    },
    "actionButton": {
      "*": {
        "padding": [
          {
            "top": 0,
            "bottom": 0,
            "left": 0,
            "right": 0
          }
        ]
      }
    }
  }
}