    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "PASSO 2 DE 5",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#C8C6C4"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Participação das razões por mês",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O QUE MOSTRA",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Como a energia cortada em cada mês se divide entre as razões informadas pelo ONS.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "COMO LER",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cada coluna soma 100%. ENE: razão energética (oferta maior que o consumo). CNF: confiabilidade elétrica da rede. REL: indisponibilidade de instalações externas. PAR: parecer de acesso.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "LÓGICA",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Mostra a participação, não o volume: um mês com pouco corte pesa igual a um mês com muito corte.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "MEDIDAS",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "[Energética (ENE)], [Confiabilidade (CNF)], [Indisponibilidade externa (REL)], [Parecer de acesso (PAR)] e [Sem razão (GWh)].",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "ATENÇÃO",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Para o volume de cada mês, veja o gráfico mensal da Visão executiva.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              }
            ]
          }
        }
