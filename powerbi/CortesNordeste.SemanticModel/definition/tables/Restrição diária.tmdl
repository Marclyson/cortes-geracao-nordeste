	/// Quantos filtros da gaveta estão em uso (contador do botão)
	measure 'Filtros · contagem' =
			INT ( ISFILTERED ( 'Calendário'[Ano] ) ) + INT ( ISFILTERED ( 'Fontes'[Fonte] ) ) + INT ( ISFILTERED ( 'Estados'[UF] ) ) + INT ( ISFILTERED ( 'Usinas'[Usina] ) )
		formatString: 0
		isHidden
		displayFolder: Visual
		lineageTag: 394b6b5f-dede-5c96-a175-71cc363f463b

	/// Texto do botão que abre a gaveta de filtros
	measure 'Filtros · botão' =
			VAR _n = [Filtros · contagem]
			RETURN "⏷  Filtros" & IF ( _n > 0, "  ·  " & _n )
		isHidden
		displayFolder: Visual
		lineageTag: 3cdfac3f-de72-5f27-bb9e-d454acf70a4d

	/// Resumo dos filtros em uso, para o cabeçalho
	measure 'Filtros ativos (texto)' =
			VAR _Ano = IF ( ISFILTERED ( 'Calendário'[Ano] ),
			        VAR _nAno = COUNTROWS ( VALUES ( 'Calendário'[Ano] ) )
			        RETURN IF ( _nAno <= 3, CONCATENATEX ( VALUES ( 'Calendário'[Ano] ), 'Calendário'[Ano], ", ", 'Calendário'[Ano], ASC ), _nAno & " anos" ) )
			VAR _Fonte = IF ( ISFILTERED ( 'Fontes'[Fonte] ),
			        VAR _nFonte = COUNTROWS ( VALUES ( 'Fontes'[Fonte] ) )
			        RETURN IF ( _nFonte <= 3, CONCATENATEX ( VALUES ( 'Fontes'[Fonte] ), 'Fontes'[Fonte], ", ", 'Fontes'[Fonte], ASC ), _nFonte & " fontes" ) )
			VAR _UF = IF ( ISFILTERED ( 'Estados'[UF] ),
			        VAR _nUF = COUNTROWS ( VALUES ( 'Estados'[UF] ) )
			        RETURN IF ( _nUF <= 3, CONCATENATEX ( VALUES ( 'Estados'[UF] ), 'Estados'[UF], ", ", 'Estados'[UF], ASC ), _nUF & " estados" ) )
			VAR _Mes = IF ( ISFILTERED ( 'Calendário'[Mês] ), VAR _nMes = COUNTROWS ( VALUES ( 'Calendário'[Mês] ) )
			        RETURN IF ( _nMes = 1, FORMAT ( MAX ( 'Calendário'[Mês] ), "mmm/yyyy" ), _nMes & " meses" ) )
			VAR _Usina = IF ( ISFILTERED ( 'Usinas'[Usina] ), IF ( HASONEVALUE ( 'Usinas'[Usina] ), VALUES ( 'Usinas'[Usina] ), COUNTROWS ( VALUES ( 'Usinas'[Usina] ) ) & " usinas" ) )
			VAR _Itens = FILTER ( { COALESCE ( _Mes, _Ano, "Todo o período" ), _Fonte, _UF, _Usina }, NOT ISBLANK ( [Value] ) && [Value] <> "" )
			RETURN CONCATENATEX ( _Itens, [Value], "  ·  " )
		isHidden
		displayFolder: Visual
		lineageTag: 33b16431-0710-525b-9388-e46b938f180c

	/// Resumo dos filtros em uso (HTML Content do cabeçalho)
	measure 'html · Filtros ativos' =
			VAR _n = [Filtros · contagem]
			RETURN "<div class='f'><span class='k'>" & IF ( _n > 0, "Filtros", "Sem filtros" ) & "</span>" & [Filtros ativos (texto)] & "</div>"
		isHidden
		displayFolder: Visual
		lineageTag: dab592fb-8d59-5ca0-9fc2-635281cf8753

	partition 'Restrição diária' = m
		mode: import
		source =
				let
				    Fonte = PostgreSQL.Database(Servidor, Banco),
				    Tabela = Fonte{[Schema = "marts", Item = "fct_restricao_usina_dia"]}[Data]
				in
