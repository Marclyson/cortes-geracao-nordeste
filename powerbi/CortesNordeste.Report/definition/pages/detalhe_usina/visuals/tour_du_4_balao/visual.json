                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Razão e origem",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O QUE MOSTRA",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Como o corte da usina se divide por razão e por origem da restrição.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "COMO LER",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cada barra soma 100%. Origem local é a rede próxima à usina; sistêmica é o sistema interligado.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "LÓGICA",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "As mesmas contas da Visão executiva, sobre todo o histórico ou o ano filtrado.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "fontWeight": "normal",
                      "color": "#FFFFFF"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "MEDIDAS",
                    "textStyle": {
                      "fontSize": "8pt",
                      "fontWeight": "bold",
                      "color": "#F2C811"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "[Energética (ENE)] a [Parecer de acesso (PAR)], [Sem razão (GWh)], [Origem local (GWh)], [Origem sistêmica (GWh)], [Sem origem (GWh)].",
                    "textStyle": {
