          "properties": {
            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"width\": \"container\",\n  \"height\": \"container\",\n  \"transform\": [\n    {\n      \"fold\": [\n        \"Energética (ENE)\",\n        \"Confiabilidade (CNF)\",\n        \"Indisponibilidade externa (REL)\",\n        \"Parecer de acesso (PAR)\",\n        \"Sem razão (GWh)\"\n      ],\n      \"as\": [\n        \"medida\",\n        \"gwh\"\n      ]\n    },\n    {\n      \"calculate\": \"datum.medida == ''Energética (ENE)'' ? ''ENE'' : datum.medida == ''Confiabilidade (CNF)'' ? ''CNF'' : datum.medida == ''Indisponibilidade externa (REL)'' ? ''REL'' : datum.medida == ''Parecer de acesso (PAR)'' ? ''PAR'' : datum.medida == ''Sem razão (GWh)'' ? ''Sem razão'' : ''Outra''\",\n      \"as\": \"razao\"\n    },\n    {\n      \"calculate\": \"indexof([''ENE'',''CNF'',''REL'',''PAR'',''Sem razão''], datum.razao)\",\n      \"as\": \"ordem\"\n    },\n    {\n      \"filter\": \"datum.gwh > 0\"\n    }\n  ],\n  \"mark\": {\n    \"type\": \"bar\",\n    \"width\": {\n      \"band\": 0.85\n    }\n  },\n  \"encoding\": {\n    \"x\": {\n      \"field\": \"Mês\",\n      \"type\": \"temporal\",\n      \"timeUnit\": \"yearmonth\",\n      \"title\": null,\n      \"axis\": {\n        \"format\": \"%Y\",\n        \"tickCount\": \"year\",\n        \"labelAlign\": \"left\",\n        \"labelPadding\": 6\n      }\n    },\n    \"y\": {\n      \"field\": \"gwh\",\n      \"type\": \"quantitative\",\n      \"stack\": \"normalize\",\n      \"title\": null,\n      \"axis\": {\n        \"format\": \".0%\",\n        \"tickCount\": 4\n      }\n    },\n    \"color\": {\n      \"field\": \"razao\",\n      \"type\": \"nominal\",\n      \"scale\": {\n        \"domain\": [\n          \"ENE\",\n          \"CNF\",\n          \"REL\",\n          \"PAR\",\n          \"Sem razão\"\n        ],\n        \"range\": [\n          \"#252423\",\n          \"#605E5C\",\n          \"#A19F9D\",\n          \"#967100\",\n          \"#E1DFDD\"\n        ]\n      },\n      \"legend\": {\n        \"orient\": \"top\",\n        \"direction\": \"horizontal\",\n        \"title\": null\n      }\n    },\n    \"order\": {\n      \"field\": \"ordem\"\n    },\n    \"tooltip\": [\n      {\n        \"field\": \"Mês\",\n        \"type\": \"temporal\",\n        \"timeUnit\": \"yearmonth\",\n        \"title\": \"Mês\",\n        \"format\": \"%m/%Y\"\n      },\n      {\n        \"field\": \"razao\",\n        \"title\": \"Razão\"\n      },\n      {\n        \"field\": \"gwh\",\n        \"title\": \"GWh\",\n        \"format\": \",.0f\"\n      }\n    ],\n    \"opacity\": {\n      \"condition\": {\n        \"test\": \"datum.__selected__ == ''off''\",\n        \"value\": 0.25\n      },\n      \"value\": 1\n    }\n  }\n}'"
                }
