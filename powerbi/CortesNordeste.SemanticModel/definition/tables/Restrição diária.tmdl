			            & "' r='3' " & IF ( _Parcial, "fill='#FFFFFF' stroke='#967100' stroke-width='1.5'", "fill='#F2C811'" ) & "/></svg>"
			    )
		isHidden
		displayFolder: Visual
		lineageTag: aa733a74-8f05-597d-84bc-3d4312c2f1e8

