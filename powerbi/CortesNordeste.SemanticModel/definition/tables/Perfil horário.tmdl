/// Geração e geração não realizada por mês, fonte, estado e patamar de 30 minutos (marts.fct_restricao_perfil_horario)
table 'Perfil horário'
	lineageTag: 81e1c108-d8d7-5349-8dfc-eadc36b196e6

	/// Geração não realizada no patamar de 30 minutos
	measure 'Não realizada no horário (GWh)' = DIVIDE(SUM('Perfil horário'[nao_realizada_mwh]), 1000)
		formatString: #,0
		lineageTag: 48780ac6-0ccc-5084-a266-b65b95a1135b

	/// Parte da geração possível cortada no patamar de 30 minutos
	measure '% cortado no horário' = DIVIDE(SUM('Perfil horário'[nao_realizada_mwh]), SUM('Perfil horário'[geracao_mwh]) + SUM('Perfil horário'[nao_realizada_mwh]))
		formatString: 0.0%
		lineageTag: 35527f51-8a7d-5c82-8263-205fd5774308

	measure 'Geração no horário (GWh)' = DIVIDE(SUM('Perfil horário'[geracao_mwh]), 1000)
		formatString: #,0
		lineageTag: 619ac898-d05d-51e3-9a66-410eda2f2a74

	column mes
		dataType: dateTime
		isHidden
		formatString: mmm/yyyy
		lineageTag: 67f3ad99-874b-554f-9d11-9257af95d958
		summarizeBy: none
		sourceColumn: mes

		annotation UnderlyingDateTimeDataType = Date

	column fonte
		dataType: string
		isHidden
		lineageTag: e55dff5e-0551-5c2d-809d-80525898c57f
		summarizeBy: none
		sourceColumn: fonte

	column uf
		dataType: string
		isHidden
