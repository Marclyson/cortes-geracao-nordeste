model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["Servidor","Banco","Restrição diária","Usinas","Calendário","Fontes","Estados","Perfil horário"]

annotation PBI_ProTooling = ["DevMode"]

ref table 'Restrição diária'
ref table Usinas
ref table Calendário
ref table Fontes
ref table Estados
ref table 'Perfil horário'

