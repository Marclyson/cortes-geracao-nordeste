	/// Faixa de KPIs da página executiva (HTML Content)
	measure 'html · KPIs' =
			VAR _Cmp = IF ( ISFILTERED ( 'Calendário' ), "vs mesmo período do ano anterior", "vs 12 meses anteriores" )
			RETURN
			    "<div class='cab'><span class='per'>" & [Rótulo do período] & "</span><span class='dt'>Dados até " & FORMAT ( [Última data com dados], "dd/mm/yyyy" ) & " · tendência de 24 meses à direita</span></div><div class='kpis'>"
			        &     "<div class='card'><div class='rot'>Geração não realizada</div><div class='lin'><div><div class='val'>" & FORMAT ( [Não realizada · período], "#,0" ) & "<span class='un'> GWh</span></div>"
			        & ( VAR _V1 = [Não realizada · var %] RETURN IF ( ISBLANK ( _V1 ), "<div class='var neu'>sem base de comparação</div>",
			            "<div class='var " & IF ( _V1 > 0, "ruim", "bom" ) & "'>" & IF ( _V1 > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _V1 ), "0.0%" ) & "</div>" ) )
			        & "</div><div class='spk'>" & [svg · sparkline não realizada] & "</div></div></div>"
			        &     "<div class='card'><div class='rot'>% da geração possível cortada</div><div class='lin'><div><div class='val'>" & FORMAT ( [% cortado · período], "0.0%" ) & "<span class='un'></span></div>"
			        & ( VAR _V2 = [% cortado · var p.p.] RETURN IF ( ISBLANK ( _V2 ), "<div class='var neu'>sem base de comparação</div>",
			            "<div class='var " & IF ( _V2 > 0, "ruim", "bom" ) & "'>" & IF ( _V2 > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _V2 ), "0.0" ) & " p.p." & "</div>" ) )
			        & "</div><div class='spk'>" & [svg · sparkline % cortado] & "</div></div></div>"
			        &     "<div class='card'><div class='rot'>Geração verificada</div><div class='lin'><div><div class='val'>" & FORMAT ( [Geração · período], "#,0" ) & "<span class='un'> GWh</span></div>"
			        & ( VAR _V3 = [Geração · var %] RETURN IF ( ISBLANK ( _V3 ), "<div class='var neu'>sem base de comparação</div>",
			            "<div class='var " & IF ( _V3 < 0, "ruim", "bom" ) & "'>" & IF ( _V3 > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _V3 ), "0.0%" ) & "</div>" ) )
			        & "</div><div class='spk'>" & [svg · sparkline geração] & "</div></div></div>"
			        &     "<div class='card'><div class='rot'>Usinas e conjuntos com corte</div><div class='lin'><div><div class='val'>" & FORMAT ( [Usinas com corte · período], "#,0" ) & "<span class='un'></span></div>"
			        & ( VAR _V4 = [Usinas com corte · var %] RETURN IF ( ISBLANK ( _V4 ), "<div class='var neu'>sem base de comparação</div>",
			            "<div class='var " & IF ( _V4 > 0, "ruim", "bom" ) & "'>" & IF ( _V4 > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _V4 ), "0.0%" ) & "</div>" ) )
			        & "</div><div class='spk'>" & [svg · sparkline usinas] & "</div></div></div>"
			        & "</div><div class='leg'>Variações " & _Cmp & ". Para cortes, alta é desfavorável (▲ em vermelho).</div>"
		isHidden
		displayFolder: Visual
		lineageTag: 300ebd8f-c2e6-54c5-ab6c-4660956d1bc6

	/// Painel de destaques da página executiva (HTML Content)
	measure 'html · Destaques' =
			VAR _T = [Não realizada · período]
			VAR _Razoes =
			    { ( "energética (ENE)", [ENE · período] ), ( "confiabilidade elétrica (CNF)", [CNF · período] ),
			      ( "indisponibilidade externa (REL)", [REL · período] ), ( "parecer de acesso (PAR)", [PAR · período] ) }
			VAR _RTop = TOPN ( 1, _Razoes, [Value2], DESC )
			VAR _RNome = MAXX ( _RTop, [Value1] )
			VAR _RPct = DIVIDE ( MAXX ( _RTop, [Value2] ), _T )
			VAR _Sis = DIVIDE ( [Origem sistêmica · período], _T )
			VAR _Est = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Estados'[Estado] ), "@v", [Não realizada · período] ), [@v], DESC )
			VAR _EstNome = MAXX ( _Est, 'Estados'[Estado] )
			VAR _EstPct = DIVIDE ( MAXX ( _Est, [@v] ), _T )
			VAR _Us = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Usinas'[Usina] ), "@v", [Não realizada · período] ), [@v], DESC )
			VAR _UsNome = MAXX ( _Us, 'Usinas'[Usina] )
			VAR _UsGWh = MAXX ( _Us, [@v] )
			VAR _Ini = [Início do período]
			VAR _Fim = [_Fim do período]
			VAR _Mes =
			    TOPN ( 1,
			        ADDCOLUMNS (
			            CALCULATETABLE ( VALUES ( 'Calendário'[Mês] ), REMOVEFILTERS ( 'Calendário' ), DATESBETWEEN ( 'Calendário'[Data], _Ini, _Fim ) ),
			            "@v", VAR _m = 'Calendário'[Mês] RETURN CALCULATE ( [Não realizada (GWh)], REMOVEFILTERS ( 'Calendário' ), 'Calendário'[Mês] = _m )
			        ), [@v], DESC )
			VAR _MesNome = FORMAT ( MAXX ( _Mes, 'Calendário'[Mês] ), "mmmm/yyyy" )
			VAR _MesGWh = MAXX ( _Mes, [@v] )
			RETURN
			    IF ( ISBLANK ( _T ) || _T = 0, "<div class='vazio'>Sem geração não realizada no período e filtros selecionados.</div>",
			    "<div class='tit'>" & IF ( ISFILTERED ( 'Calendário' ), "Destaques do período filtrado", "Destaques dos últimos 12 meses" ) & "</div><ul>"
			        & "<li><b>" & FORMAT ( _RPct, "0%" ) & "</b> do corte teve razão <b>" & _RNome & "</b>.</li>"
			        & IF ( NOT ISBLANK ( _Sis ), "<li><b>" & FORMAT ( _Sis, "0%" ) & "</b> veio de restrições <b>sistêmicas</b>, e não da rede local da usina.</li>" )
			        & "<li><b>" & _EstNome & "</b> concentrou <b>" & FORMAT ( _EstPct, "0%" ) & "</b> da energia cortada.</li>"
			        & "<li>Maior corte individual: <b>" & _UsNome & "</b>, com " & FORMAT ( _UsGWh, "#,0" ) & " GWh.</li>"
			        & "<li>Mês com mais corte: <b>" & _MesNome & "</b> (" & FORMAT ( _MesGWh, "#,0" ) & " GWh).</li>"
			        & "</ul><div class='nota'>Mesmo período dos cartões, com os filtros selecionados. Associação não implica causa.</div>" )
		isHidden
		displayFolder: Visual
		lineageTag: 7c78beb5-7c4d-5937-afe2-dbe7762f70f2

	/// Dias com alguma geração não realizada
	measure 'Dias com corte' = CALCULATE(DISTINCTCOUNT('Restrição diária'[dia]), 'Restrição diária'[nao_realizada_mwh] > 0)
		formatString: #,0
		displayFolder: Base
		lineageTag: e01df476-36b7-5869-a2a4-2511f639df66

	/// Média de horas com restrição em cada dia de cada usina com corte
	measure 'Horas por dia com corte' = DIVIDE([Horas de restrição], CALCULATE(COUNTROWS('Restrição diária'), 'Restrição diária'[nao_realizada_mwh] > 0))
		formatString: 0.0
		displayFolder: Base
		lineageTag: de9849d0-5120-5bbc-87a5-c4865c492585

	/// Concentração do corte por ponto de conexão e por usina (HTML Content)
	measure 'html · Concentração' =
			VAR _P = FILTER ( ADDCOLUMNS ( VALUES ( 'Usinas'[Ponto de conexão] ), "@v", [Não realizada (GWh)] ), [@v] > 0 )
			VAR _PT = SUMX ( _P, [@v] )
			VAR _PN = COUNTROWS ( _P )
			VAR _P80 = COUNTROWS ( FILTER ( _P, VAR _x = [@v] RETURN SUMX ( FILTER ( _P, [@v] > _x ), [@v] ) < 0.8 * _PT ) )
			VAR _U = FILTER ( ADDCOLUMNS ( VALUES ( 'Usinas'[ID da usina] ), "@v", [Não realizada (GWh)] ), [@v] > 0 )
			VAR _UT = SUMX ( _U, [@v] )
			VAR _UN = COUNTROWS ( _U )
			VAR _U80 = COUNTROWS ( FILTER ( _U, VAR _x = [@v] RETURN SUMX ( FILTER ( _U, [@v] > _x ), [@v] ) < 0.8 * _UT ) )
			VAR _Top = TOPN ( 1, _P, [@v], DESC )
			VAR _TopNome = MAXX ( _Top, 'Usinas'[Ponto de conexão] )
			VAR _TopPct = DIVIDE ( MAXX ( _Top, [@v] ), _PT )
			RETURN
			    IF ( ISBLANK ( _PT ), "<div class='vazio'>Sem geração não realizada nos filtros selecionados.</div>",
			    "<div class='tit'>Concentração do corte</div>"
			        & "<div class='st'><div class='n'>" & _P80 & "<span> de " & _PN & "</span></div><div class='d'>pontos de conexão somam 80% da energia cortada</div></div>"
			        & "<div class='st'><div class='n'>" & _U80 & "<span> de " & _UN & "</span></div><div class='d'>usinas e conjuntos somam 80% da energia cortada</div></div>"
			        & "<div class='top'>Maior ponto: <b>" & _TopNome & "</b>, com " & FORMAT ( _TopPct, "0%" ) & " do total.</div>" )
		isHidden
		displayFolder: Visual
		lineageTag: fdfd74b5-4dc2-5996-aeba-c0974ae4ba5e

	/// Ficha da usina selecionada (HTML Content)
	measure 'html · Usina' =
			VAR _N = DISTINCTCOUNT ( 'Usinas'[ID da usina] )
			VAR _Razoes =
			    { ( "Energética (ENE)", [Energética (ENE)] ), ( "Confiabilidade (CNF)", [Confiabilidade (CNF)] ),
			      ( "Indisponibilidade externa (REL)", [Indisponibilidade externa (REL)] ), ( "Parecer de acesso (PAR)", [Parecer de acesso (PAR)] ) }
			VAR _RTop = MAXX ( TOPN ( 1, _Razoes, [Value2], DESC ), [Value1] )
			VAR _Cab =
			    IF ( _N = 1,
			        "<div class='k'>" & SELECTEDVALUE ( 'Usinas'[Fonte] ) & " · " & SELECTEDVALUE ( 'Usinas'[Estado] ) & IF ( SELECTEDVALUE ( 'Usinas'[Conjunto de usinas] ), " · conjunto de usinas", "" ) & "</div>"
			            & "<div class='nm'>" & SELECTEDVALUE ( 'Usinas'[Usina] ) & "</div>"
			            & "<div class='at'><span><b>Agente</b> " & SELECTEDVALUE ( 'Usinas'[Agente operador] ) & "</span><span><b>Ponto de conexão</b> " & SELECTEDVALUE ( 'Usinas'[Ponto de conexão] ) & "</span>"
			            & "<span><b>CEG</b> " & COALESCE ( SELECTEDVALUE ( 'Usinas'[CEG] ), "—" ) & "</span><span><b>Nos dados</b> " & FORMAT ( SELECTEDVALUE ( 'Usinas'[Primeiro dia] ), "mm/yyyy" ) & " a " & FORMAT ( SELECTEDVALUE ( 'Usinas'[Último dia] ), "mm/yyyy" ) & "</span></div>",
			        "<div class='k'>Nenhuma usina selecionada</div><div class='nm'>Todas as " & FORMAT ( _N, "#,0" ) & " usinas e conjuntos</div><div class='at'><span>Abra <b>Filtros</b> e escolha a usina para ver a ficha dela.</span></div>" )
			RETURN
			    "<div class='wrap'><div class='cab'>" & _Cab & "</div><div class='kp'>"
			        & "<div class='c'><div class='r'>Não realizada</div><div class='v'>" & FORMAT ( [Não realizada (GWh)], "#,0" ) & "<small> GWh</small></div></div>"
			        & "<div class='c'><div class='r'>% cortado</div><div class='v'>" & FORMAT ( [% cortado], "0.0%" ) & "</div></div>"
			        & "<div class='c'><div class='r'>Dias com corte</div><div class='v'>" & FORMAT ( [Dias com corte], "#,0" ) & "</div></div>"
			        & "<div class='c'><div class='r'>Horas por dia com corte</div><div class='v'>" & FORMAT ( [Horas por dia com corte], "0.0" ) & "<small> h</small></div></div>"
			        & "<div class='c'><div class='r'>Razão principal</div><div class='v t'>" & COALESCE ( _RTop, "—" ) & "</div></div>"
			        & "</div></div>"
		isHidden
		displayFolder: Visual
		lineageTag: 4a2506ea-d0d1-52c7-9c33-17ded42361d3

	/// Geração não realizada das 10 usinas com mais corte; vazio para as demais (ordena e limita o ranking)
	measure 'Ranking · valor' =
			VAR _v = [Não realizada (GWh)]
			VAR _Tab = FILTER ( ADDCOLUMNS ( ALLSELECTED ( 'Usinas'[ID da usina] ), "@v", [Não realizada (GWh)] ), [@v] > 0 )
			VAR _r = COUNTROWS ( FILTER ( _Tab, [@v] > _v ) ) + 1
			RETURN IF ( HASONEVALUE ( 'Usinas'[ID da usina] ) && _v > 0 && _r <= 10, _v )
		formatString: #,0
		isHidden
		displayFolder: Visual
		lineageTag: 6ed9bb6c-297d-583b-a701-a58d9c1df562

	/// Uma linha do ranking das 10 usinas com mais corte (HTML Content com a usina no Contexto)
	measure 'html · Linha ranking' =
			VAR _v = [Não realizada (GWh)]
			VAR _Tab = FILTER ( ADDCOLUMNS ( ALLSELECTED ( 'Usinas'[ID da usina] ), "@v", [Não realizada (GWh)] ), [@v] > 0 )
			VAR _r = COUNTROWS ( FILTER ( _Tab, [@v] > _v ) ) + 1
			VAR _Max = MAXX ( _Tab, [@v] )
			VAR _meta = SELECTEDVALUE ( 'Usinas'[Fonte] ) & " · " & SELECTEDVALUE ( 'Usinas'[UF] ) & " · " & SELECTEDVALUE ( 'Usinas'[Agente operador] )
			VAR _cab = "<div class='lin cab'><div></div><div>Usina ou conjunto</div><div class='dir'>Não realizada</div><div class='dir'>% cortado</div><div>24 meses</div></div>"
			RETURN
			    IF ( HASONEVALUE ( 'Usinas'[ID da usina] ) && _v > 0 && _r <= 10,
			        IF ( _r = 1, _cab, "" )
			            & "<div class='lin" & IF ( _r = 1, " top", "" ) & "'><div class='r'>" & _r & "</div>"
			            & "<div><div class='nm'>" & SELECTEDVALUE ( 'Usinas'[Usina] ) & "</div><div class='mt'>" & _meta & "</div></div>"
			            & "<div class='dir'><div class='vl'>" & FORMAT ( _v, "#,0" ) & " GWh</div><div class='bar'><span style='width:" & FORMAT ( DIVIDE ( _v, _Max ) * 100, "0", "en-US" ) & "%'></span></div></div>"
			            & "<div class='dir pc'>" & FORMAT ( [% cortado], "0.0%" ) & "</div><div class='sp'>" & [svg · sparkline não realizada] & "</div></div>" )
		isHidden
		displayFolder: Visual
		lineageTag: c965feca-608d-5964-9408-b24c02b44585

	/// Dica de ferramenta do mês (HTML Content)
	measure 'html · Dica mês' =
			VAR _Mes = MAX ( 'Calendário'[Mês] )
			VAR _Ult = [Última data com dados]
			VAR _Fonte = IF ( HASONEVALUE ( 'Fontes'[Fonte] ), " · " & VALUES ( 'Fontes'[Fonte] ), "" )
			VAR _NR = [Não realizada (GWh)]
			VAR _AA = CALCULATE ( [Não realizada (GWh)], SAMEPERIODLASTYEAR ( 'Calendário'[Data] ) )
			VAR _Var = IF ( NOT ISBLANK ( _AA ) && _AA <> 0, DIVIDE ( _NR - _AA, _AA ) )
			VAR _Tab =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( 'Calendário'[Mês] ), REMOVEFILTERS ( 'Calendário' ) ),
			        "@v", VAR _m = 'Calendário'[Mês] RETURN CALCULATE ( [Não realizada (GWh)], REMOVEFILTERS ( 'Calendário' ), 'Calendário'[Mês] = _m )
			    )
			VAR _Rank = COUNTROWS ( FILTER ( _Tab, [@v] > _NR ) ) + 1
			VAR _N = COUNTROWS ( FILTER ( _Tab, NOT ISBLANK ( [@v] ) ) )
			VAR _Est = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Estados'[Estado] ), "@v", [Não realizada (GWh)] ), [@v], DESC )
			VAR _Parcial = _Mes <= _Ult && EOMONTH ( _Mes, 0 ) > _Ult
			VAR _T = [Não realizada (GWh)]
			VAR _E = DIVIDE ( [Energética (ENE)], _T )
			VAR _C = DIVIDE ( [Confiabilidade (CNF)], _T )
			VAR _R = DIVIDE ( [Indisponibilidade externa (REL)], _T )
			VAR _P = DIVIDE ( [Parecer de acesso (PAR)], _T )
			VAR _Seg = ( VAR p = _E RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#FFFFFF'></span>" )
			    & ( VAR p = _C RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#A19F9D'></span>" )
			    & ( VAR p = _R RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#605E5C'></span>" )
			    & ( VAR p = _P RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#F2C811'></span>" )
			VAR _Leg = "ENE " & FORMAT ( _E, "0%" ) & " · CNF " & FORMAT ( _C, "0%" ) & " · REL " & FORMAT ( _R, "0%" ) & IF ( _P >= 0.005, " · PAR " & FORMAT ( _P, "0%" ) )
			VAR _BlocoRazoes = "<div class='sec'>Razão do corte</div><div class='bar'>" & _Seg & "</div><div class='leg'>" & _Leg & "</div>"
			RETURN
			    IF ( ISBLANK ( _NR ) || _NR = 0, "<div class='tt'><div class='k'>Mês</div><div class='t'>" & FORMAT ( _Mes, "mmmm/yyyy" ) & _Fonte & "</div><div class='c'>Sem geração não realizada neste mês.</div></div>",
			    "<div class='tt'><div class='k'>Mês</div><div class='t'>" & FORMAT ( _Mes, "mmmm/yyyy" ) & _Fonte & "</div>"
			        & "<div class='g'><div><div class='v'>" & FORMAT ( _NR, "#,0" ) & "<small> GWh</small></div><div class='l'>não gerados</div></div>"
			        & "<div><div class='v'>" & FORMAT ( [% cortado], "0.0%" ) & "</div><div class='l'>da geração possível</div></div></div>"
			        & "<div class='c'>" & IF ( ISBLANK ( _Var ), "Sem base no mesmo mês do ano anterior", "<b class='" & IF ( _Var > 0, "ruim", "bom" ) & "'>" & IF ( _Var > 0, "▲ ", "▼ " ) & FORMAT ( ABS ( _Var ), "0%" ) & "</b> vs " & FORMAT ( EDATE ( _Mes, -12 ), "mmm/yyyy" ) )
			        & " · <b>" & _Rank & "º</b> maior de " & _N & " meses</div>"
			        & _BlocoRazoes
			        & "<div class='f'>Mais corte: <b>" & MAXX ( _Est, 'Estados'[Estado] ) & "</b> (" & FORMAT ( DIVIDE ( MAXX ( _Est, [@v] ), _NR ), "0%" ) & " do mês)</div>"
			        & IF ( _Parcial, "<div class='n'>Mês incompleto: dados até " & FORMAT ( _Ult, "dd/mm/yyyy" ) & "</div>" )
			        & "</div>" )
		isHidden
		displayFolder: Dicas
		lineageTag: 6f36cb78-584a-5e51-adb6-2a1729ceb8ba

	/// Dica de ferramenta do estado (HTML Content)
	measure 'html · Dica estado' =
			VAR _Nome = SELECTEDVALUE ( 'Estados'[Estado] )
			VAR _NR = [Não realizada (GWh)]
			VAR _Pct = [% cortado]
			VAR _Tot = CALCULATE ( [Não realizada (GWh)], REMOVEFILTERS ( 'Estados' ) )
			VAR _Tab =
			    FILTER (
			        ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'Estados'[Estado] ), REMOVEFILTERS ( 'Estados' ) ),
			            "@p", VAR _e = 'Estados'[Estado] RETURN CALCULATE ( [% cortado], REMOVEFILTERS ( 'Estados' ), 'Estados'[Estado] = _e ) ),
			        NOT ISBLANK ( [@p] ) )
			VAR _Rank = COUNTROWS ( FILTER ( _Tab, [@p] > _Pct ) ) + 1
			VAR _Us = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Usinas'[Usina] ), "@v", [Não realizada (GWh)] ), [@v], DESC )
			VAR _Pt = TOPN ( 1, ADDCOLUMNS ( VALUES ( 'Usinas'[Ponto de conexão] ), "@v", [Não realizada (GWh)] ), [@v], DESC )
			VAR _T = [Não realizada (GWh)]
			VAR _E = DIVIDE ( [Energética (ENE)], _T )
			VAR _C = DIVIDE ( [Confiabilidade (CNF)], _T )
			VAR _R = DIVIDE ( [Indisponibilidade externa (REL)], _T )
			VAR _P = DIVIDE ( [Parecer de acesso (PAR)], _T )
			VAR _Seg = ( VAR p = _E RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#FFFFFF'></span>" )
			    & ( VAR p = _C RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#A19F9D'></span>" )
			    & ( VAR p = _R RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#605E5C'></span>" )
			    & ( VAR p = _P RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#F2C811'></span>" )
			VAR _Leg = "ENE " & FORMAT ( _E, "0%" ) & " · CNF " & FORMAT ( _C, "0%" ) & " · REL " & FORMAT ( _R, "0%" ) & IF ( _P >= 0.005, " · PAR " & FORMAT ( _P, "0%" ) )
			VAR _BlocoRazoes = "<div class='sec'>Razão do corte</div><div class='bar'>" & _Seg & "</div><div class='leg'>" & _Leg & "</div>"
			RETURN
			    IF ( ISBLANK ( _NR ), "<div class='tt'><div class='k'>Estado</div><div class='t'>" & _Nome & "</div><div class='c'>Sem geração não realizada nos filtros.</div></div>",
			    "<div class='tt'><div class='k'>Estado</div><div class='t'>" & _Nome & "</div>"
			        & "<div class='g'><div><div class='v'>" & FORMAT ( _Pct, "0.0%" ) & "</div><div class='l'>da geração possível cortada</div></div>"
			        & "<div><div class='v'>" & FORMAT ( _NR, "#,0" ) & "<small> GWh</small></div><div class='l'>" & FORMAT ( DIVIDE ( _NR, _Tot ), "0%" ) & " do corte total</div></div></div>"
			        & "<div class='c'><b>" & _Rank & "º</b> maior % de " & COUNTROWS ( _Tab ) & " estados · " & FORMAT ( [Usinas com corte], "#,0" ) & " usinas com corte</div>"
			        & "<div class='spk'><span>% cortado, 24 meses</span>" & [svg · sparkline % cortado] & "</div>"
			        & _BlocoRazoes
			        & "<div class='f'>Maior usina: <b>" & MAXX ( _Us, 'Usinas'[Usina] ) & "</b> · maior ponto: <b>" & MAXX ( _Pt, 'Usinas'[Ponto de conexão] ) & "</b></div>"
			        & "</div>" )
		isHidden
		displayFolder: Dicas
		lineageTag: 59cd04f3-f485-5ea0-8e24-d0545faf642f

	/// Dica de ferramenta da usina (HTML Content)
	measure 'html · Dica usina' =
			VAR _N = DISTINCTCOUNT ( 'Usinas'[ID da usina] )
			VAR _NR = [Não realizada (GWh)]
			VAR _Tab =
			    FILTER (
			        ADDCOLUMNS ( CALCULATETABLE ( VALUES ( 'Usinas'[ID da usina] ), REMOVEFILTERS ( 'Usinas' ) ),
			            "@v", VAR _u = 'Usinas'[ID da usina] RETURN CALCULATE ( [Não realizada (GWh)], REMOVEFILTERS ( 'Usinas' ), 'Usinas'[ID da usina] = _u ) ),
			        [@v] > 0 )
			VAR _Rank = COUNTROWS ( FILTER ( _Tab, [@v] > _NR ) ) + 1
			VAR _T = [Não realizada (GWh)]
			VAR _E = DIVIDE ( [Energética (ENE)], _T )
			VAR _C = DIVIDE ( [Confiabilidade (CNF)], _T )
			VAR _R = DIVIDE ( [Indisponibilidade externa (REL)], _T )
			VAR _P = DIVIDE ( [Parecer de acesso (PAR)], _T )
			VAR _Seg = ( VAR p = _E RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#FFFFFF'></span>" )
			    & ( VAR p = _C RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#A19F9D'></span>" )
			    & ( VAR p = _R RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#605E5C'></span>" )
			    & ( VAR p = _P RETURN "<span style='width:" & FORMAT ( p * 100, "0.0", "en-US" ) & "%;background:#F2C811'></span>" )
			VAR _Leg = "ENE " & FORMAT ( _E, "0%" ) & " · CNF " & FORMAT ( _C, "0%" ) & " · REL " & FORMAT ( _R, "0%" ) & IF ( _P >= 0.005, " · PAR " & FORMAT ( _P, "0%" ) )
			VAR _BlocoRazoes = "<div class='sec'>Razão do corte</div><div class='bar'>" & _Seg & "</div><div class='leg'>" & _Leg & "</div>"
			RETURN
			    IF ( _N <> 1, "<div class='tt'><div class='c'>Passe o mouse sobre uma usina.</div></div>",
			    "<div class='tt'><div class='k'>" & SELECTEDVALUE ( 'Usinas'[Fonte] ) & " · " & SELECTEDVALUE ( 'Usinas'[UF] ) & "</div><div class='t'>" & SELECTEDVALUE ( 'Usinas'[Usina] ) & "</div>"
			        & "<div class='m'>" & SELECTEDVALUE ( 'Usinas'[Agente operador] ) & " · " & SELECTEDVALUE ( 'Usinas'[Ponto de conexão] ) & "</div>"
			        & "<div class='g'><div><div class='v'>" & FORMAT ( _NR, "#,0" ) & "<small> GWh</small></div><div class='l'>não gerados</div></div>"
			        & "<div><div class='v'>" & FORMAT ( [% cortado], "0.0%" ) & "</div><div class='l'>de " & FORMAT ( [Geração possível (GWh)], "#,0" ) & " GWh possíveis</div></div></div>"
			        & "<div class='c'><b>" & _Rank & "º</b> maior corte de " & COUNTROWS ( _Tab ) & " usinas · " & FORMAT ( [Dias com corte], "#,0" ) & " dias com corte</div>"
			        & "<div class='spk'><span>Corte mensal, 24 meses</span>" & [svg · sparkline não realizada] & "</div>"
			        & _BlocoRazoes
			        & "</div>" )
		isHidden
		displayFolder: Dicas
		lineageTag: bf0769a2-5abe-5c54-a3bf-d09abe0362e5





